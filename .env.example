# ==============================================================================
# GLOBAL MULTI-VENDOR MARKETPLACE - ENVIRONMENT CONTRACT SPECIFICATION
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary Backend BFF / Microservice Gateway
BACKEND_API_BASE_URL=http://localhost:8080/api/v1
BACKEND_API_TIMEOUT_MS=5000

# Mock Service Worker Toggle (Enable for offline frontend development)
NEXT_PUBLIC_ENABLE_MOCKS=false

# Authentication & Session Security
# SESSION_SECRET must be at least 32 characters long
SESSION_SECRET=replace_with_a_secure_minimum_32_character_hex_secret_in_production
JWT_ISSUER=marketplace.enterprise.local
JWT_AUDIENCE=marketplace-web-client

# Realtime Event Stream (SSE / WebSocket)
NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:8080/ws
NEXT_PUBLIC_SSE_ENDPOINT=http://localhost:8080/api/v1/events/stream

# AI Assistant Service Endpoint
AI_SERVICE_URL=http://localhost:8090/ai/v1
AI_SERVICE_API_KEY=

# Observability & Monitoring
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
